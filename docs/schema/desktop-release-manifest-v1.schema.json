{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.neondiff.com/schema/desktop-release-manifest-v1.json",
  "title": "NeonDiff Desktop release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestKind", "product", "version", "releaseLevel", "channel", "contract", "source", "artifact", "signing", "notarization", "stapling", "postStapleCodeSign", "gatekeeper", "feed", "site", "billing", "customer", "runtime", "rollback", "references", "proofBoundary"],
  "properties": {
    "schemaVersion": {"const": "desktop-release-manifest.v1"}, "manifestKind": {"const": "desktop-release"}, "product": {"const": "NeonDiff Desktop"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "releaseLevel": {"enum": ["template", "candidate", "beta", "stable"]}, "channel": {"enum": ["beta", "stable"]},
    "contract": {"$ref": "#/$defs/contract"}, "source": {"$ref": "#/$defs/source"}, "artifact": {"$ref": "#/$defs/artifact"}, "signing": {"$ref": "#/$defs/identityGate"}, "notarization": {"$ref": "#/$defs/gate"}, "stapling": {"$ref": "#/$defs/gate"}, "postStapleCodeSign": {"$ref": "#/$defs/identityGate"}, "gatekeeper": {"$ref": "#/$defs/gatekeeper"}, "feed": {"$ref": "#/$defs/feed"}, "site": {"$ref": "#/$defs/site"}, "billing": {"$ref": "#/$defs/gate"}, "customer": {"$ref": "#/$defs/customer"}, "runtime": {"$ref": "#/$defs/runtime"}, "rollback": {"$ref": "#/$defs/rollback"},
    "references": {"type": "object", "additionalProperties": false, "required": ["roadmap", "execution", "updater", "desktopEvaluation", "packaging"], "properties": {"roadmap": {"$ref": "#/$defs/https"}, "execution": {"$ref": "#/$defs/https"}, "updater": {"$ref": "#/$defs/https"}, "desktopEvaluation": {"$ref": "#/$defs/https"}, "packaging": {"$ref": "#/$defs/https"}}},
    "proofBoundary": {"type": "object", "additionalProperties": false, "required": ["allows", "excludes"], "properties": {"allows": {"$ref": "#/$defs/refs"}, "excludes": {"$ref": "#/$defs/refs"}}}
  },
  "$defs": {
    "str": {"type": "string", "minLength": 1}, "maybe": {"type": ["string", "null"]}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "maybeSha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "https": {"type": "string", "pattern": "^https://[^\\s]+$"}, "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/str"}}, "state": {"enum": ["pending", "proven", "blocked", "not-performed", "not-applicable"]},
    "contract": {"type": "object", "additionalProperties": false, "required": ["mode", "paidContract", "byoGitHubEnabled", "managedBrokerEnabled", "brokerOrigin"], "properties": {"mode": {"const": "byo"}, "paidContract": {"enum": ["paid-mac-beta-byo-v1", "paid-mac-ga-byo-v1"]}, "byoGitHubEnabled": {"const": true}, "managedBrokerEnabled": {"const": false}, "brokerOrigin": {"const": null}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "ref", "cleanCheckout", "workflowRunRef", "artifactRef"], "properties": {"repository": {"const": "electricsheephq/evaos-code-review-bot-neondiff"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "ref": {"$ref": "#/$defs/str"}, "cleanCheckout": {"const": true}, "workflowRunRef": {"$ref": "#/$defs/maybe"}, "artifactRef": {"$ref": "#/$defs/maybe"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["state", "version", "bundleId", "appPath", "archiveName", "build", "sha256", "workflowRunRef", "artifactRef", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "version": {"$ref": "#/$defs/maybe"}, "bundleId": {"const": "com.electricsheephq.NeonDiffDesktop"}, "appPath": {"$ref": "#/$defs/str"}, "archiveName": {"$ref": "#/$defs/maybe"}, "build": {"type": "string", "pattern": "^[0-9]+$"}, "sha256": {"$ref": "#/$defs/maybeSha"}, "workflowRunRef": {"$ref": "#/$defs/maybe"}, "artifactRef": {"$ref": "#/$defs/maybe"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["state", "artifactSha256", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "identityGate": {"type": "object", "additionalProperties": false, "required": ["state", "identity", "teamIdentifier", "artifactSha256", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "identity": {"$ref": "#/$defs/maybe"}, "teamIdentifier": {"$ref": "#/$defs/maybe"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "gatekeeper": {"type": "object", "additionalProperties": false, "required": ["state", "assessment", "artifactSha256", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "assessment": {"$ref": "#/$defs/maybe"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "feed": {"type": "object", "additionalProperties": false, "required": ["state", "channel", "embeddedFeedUrl", "feedUrl", "publicKeyIdentity", "publicKeyRef", "artifactUrl", "artifactSha256", "signatureRef", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "channel": {"enum": ["beta", "stable"]}, "embeddedFeedUrl": {"$ref": "#/$defs/maybe"}, "feedUrl": {"$ref": "#/$defs/maybe"}, "publicKeyIdentity": {"$ref": "#/$defs/maybe"}, "publicKeyRef": {"$ref": "#/$defs/maybe"}, "artifactUrl": {"$ref": "#/$defs/maybe"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "signatureRef": {"$ref": "#/$defs/maybe"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "site": {"type": "object", "additionalProperties": false, "required": ["state", "productUrl", "downloadUrl", "releaseNotesUrl", "artifactSha256", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "productUrl": {"$ref": "#/$defs/https"}, "downloadUrl": {"$ref": "#/$defs/maybe"}, "releaseNotesUrl": {"$ref": "#/$defs/maybe"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "customer": {"type": "object", "additionalProperties": false, "required": ["state", "canaryRef", "requiredScenarios", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "canaryRef": {"$ref": "#/$defs/maybe"}, "requiredScenarios": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/str"}}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["state", "workerVersion", "artifactSha256", "configIdentitySha256", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "workerVersion": {"$ref": "#/$defs/maybe"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "configIdentitySha256": {"$ref": "#/$defs/maybeSha"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["state", "targetVersion", "targetArtifactSha256", "targetReleaseRef", "targetSignatureRef", "targetPublicKeyRef", "statePreservationRequired", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "targetVersion": {"$ref": "#/$defs/maybe"}, "targetArtifactSha256": {"$ref": "#/$defs/maybeSha"}, "targetReleaseRef": {"$ref": "#/$defs/maybe"}, "targetSignatureRef": {"$ref": "#/$defs/maybe"}, "targetPublicKeyRef": {"$ref": "#/$defs/maybe"}, "statePreservationRequired": {"const": true}, "evidenceRefs": {"$ref": "#/$defs/refs"}}}
  }
}
