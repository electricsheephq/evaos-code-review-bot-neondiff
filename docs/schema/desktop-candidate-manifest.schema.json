{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.neondiff.com/schema/desktop-candidate-manifest.v1.json",
  "title": "NeonDiff Desktop candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "releaseLevel", "channel", "contract", "source", "artifact", "signing", "notarization", "feed", "site", "billing", "customer", "runtime", "rollback", "references", "proofBoundary"],
  "properties": {
    "schemaVersion": {"const": "desktop-candidate-manifest.v1"}, "product": {"const": "NeonDiff Desktop"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}, "releaseLevel": {"enum": ["candidate", "beta", "stable"]}, "channel": {"enum": ["beta", "stable"]},
    "contract": {"$ref": "#/$defs/contract"}, "source": {"$ref": "#/$defs/source"}, "artifact": {"$ref": "#/$defs/artifact"}, "signing": {"$ref": "#/$defs/gate"}, "notarization": {"$ref": "#/$defs/gate"}, "feed": {"$ref": "#/$defs/feed"}, "site": {"$ref": "#/$defs/site"}, "billing": {"$ref": "#/$defs/billing"}, "customer": {"$ref": "#/$defs/customer"}, "runtime": {"$ref": "#/$defs/runtime"}, "rollback": {"$ref": "#/$defs/rollback"},
    "references": {"type": "object", "additionalProperties": false, "required": ["roadmap", "execution", "milestone", "updater", "desktopEvaluation", "runtime", "packaging"], "properties": {"roadmap": {"$ref": "#/$defs/https"}, "execution": {"$ref": "#/$defs/https"}, "milestone": {"$ref": "#/$defs/https"}, "updater": {"$ref": "#/$defs/https"}, "desktopEvaluation": {"$ref": "#/$defs/https"}, "runtime": {"$ref": "#/$defs/https"}, "packaging": {"$ref": "#/$defs/https"}}},
    "proofBoundary": {"type": "object", "additionalProperties": false, "required": ["allows", "excludes"], "properties": {"allows": {"$ref": "#/$defs/refs"}, "excludes": {"$ref": "#/$defs/refs"}}}
  },
  "$defs": {
    "str": {"type": "string", "minLength": 1}, "maybeStr": {"type": ["string", "null"]}, "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "maybeSha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "https": {"type": "string", "pattern": "^https://[^\\s]+$"}, "refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/str"}}, "state": {"enum": ["pending", "proven", "not-applicable", "not-performed", "blocked"]},
    "contract": {"type": "object", "additionalProperties": false, "required": ["mode", "paidContract", "byoGitHubEnabled", "managedBrokerEnabled", "brokerOrigin"], "properties": {"mode": {"const": "byo"}, "paidContract": {"enum": ["paid-mac-beta-byo-v1", "paid-mac-ga-byo-v1"]}, "byoGitHubEnabled": {"const": true}, "managedBrokerEnabled": {"const": false}, "brokerOrigin": {"const": null}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "ref", "cleanCheckout", "workflowRunRef", "artifactRef"], "properties": {"repository": {"const": "electricsheephq/evaos-code-review-bot-neondiff"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "ref": {"$ref": "#/$defs/str"}, "cleanCheckout": {"const": true}, "workflowRunRef": {"$ref": "#/$defs/maybeStr"}, "artifactRef": {"$ref": "#/$defs/maybeStr"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["state", "version", "bundleId", "appPath", "archiveName", "build", "sha256", "workflowRunRef", "artifactRef", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "version": {"$ref": "#/$defs/maybeStr"}, "bundleId": {"const": "com.electricsheephq.NeonDiffDesktop"}, "appPath": {"$ref": "#/$defs/str"}, "archiveName": {"$ref": "#/$defs/maybeStr"}, "build": {"$ref": "#/$defs/str"}, "sha256": {"$ref": "#/$defs/maybeSha"}, "workflowRunRef": {"$ref": "#/$defs/maybeStr"}, "artifactRef": {"$ref": "#/$defs/maybeStr"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["state", "identity", "artifactSha256", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "identity": {"$ref": "#/$defs/maybeStr"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "feed": {"type": "object", "additionalProperties": false, "required": ["state", "technology", "channel", "feedUrl", "publicKeyRef", "artifactUrl", "artifactSha256", "signatureRef", "rollbackRef", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "technology": {"const": "Sparkle 2"}, "channel": {"enum": ["beta", "stable"]}, "feedUrl": {"$ref": "#/$defs/maybeStr"}, "publicKeyRef": {"$ref": "#/$defs/maybeStr"}, "artifactUrl": {"$ref": "#/$defs/maybeStr"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "signatureRef": {"$ref": "#/$defs/maybeStr"}, "rollbackRef": {"$ref": "#/$defs/maybeStr"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "site": {"type": "object", "additionalProperties": false, "required": ["state", "productUrl", "downloadUrl", "releaseNotesUrl", "artifactSha256", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "productUrl": {"$ref": "#/$defs/https"}, "downloadUrl": {"$ref": "#/$defs/maybeStr"}, "releaseNotesUrl": {"$ref": "#/$defs/maybeStr"}, "artifactSha256": {"$ref": "#/$defs/maybeSha"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "billing": {"type": "object", "additionalProperties": false, "required": ["state", "model", "authorityRef", "activationRef", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "model": {"const": "paid-byo"}, "authorityRef": {"$ref": "#/$defs/maybeStr"}, "activationRef": {"$ref": "#/$defs/maybeStr"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "customer": {"type": "object", "additionalProperties": false, "required": ["state", "canaryRef", "requiredScenarios", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "canaryRef": {"$ref": "#/$defs/maybeStr"}, "requiredScenarios": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/str"}}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "runtime": {"type": "object", "additionalProperties": false, "required": ["state", "launchdLabel", "workerVersion", "configIdentitySha256", "noDowntimeInvariant", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "launchdLabel": {"$ref": "#/$defs/str"}, "workerVersion": {"$ref": "#/$defs/maybeStr"}, "configIdentitySha256": {"$ref": "#/$defs/maybeSha"}, "noDowntimeInvariant": {"$ref": "#/$defs/str"}, "evidenceRefs": {"$ref": "#/$defs/refs"}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["state", "targetVersion", "targetArtifactSha256", "targetReleaseRef", "targetSignatureRef", "targetPublicKeyRef", "statePreservationRequired", "evidenceRefs"], "properties": {"state": {"$ref": "#/$defs/state"}, "targetVersion": {"$ref": "#/$defs/maybeStr"}, "targetArtifactSha256": {"$ref": "#/$defs/maybeSha"}, "targetReleaseRef": {"$ref": "#/$defs/maybeStr"}, "targetSignatureRef": {"$ref": "#/$defs/maybeStr"}, "targetPublicKeyRef": {"$ref": "#/$defs/maybeStr"}, "statePreservationRequired": {"const": true}, "evidenceRefs": {"$ref": "#/$defs/refs"}}}
  }
}
