<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Supported macOS shape: replace the account-scoped path and selected label/IDs
  with values generated by NeonDiff Desktop. The signed wrapper dispatches the
  sealed helper at /Applications/NeonDiff.app/Contents/Helpers/NeonDiffWorker
  with daemon --runtime-credentials-stdin true --dry-run false. Credentials are
  Keychain-only and are delivered through bounded stdin; this plist has no
  credential environment.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.electricsheephq.NeonDiffDesktop.selected</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/NeonDiff.app/Contents/MacOS/NeonDiffDesktop</string>
    <string>--neondiff-worker-daemon</string>
    <string>--config</string>
    <string>/Users/your-login/Library/Application Support/NeonDiffDesktop/Accounts/selected-account/Bots/selected-bot/config.local.json</string>
    <string>--launchd-label</string>
    <string>com.electricsheephq.NeonDiffDesktop.selected</string>
    <string>--github-app-id</string>
    <string>REPLACE_WITH_APP_ID</string>
    <string>--license-machine-id</string>
    <string>REPLACE_WITH_KEYCHAIN_DEVICE_ID</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
